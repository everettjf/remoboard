          "vi": "TỪ MÁY TÍNH ĐẾN IPHONE",
          "fr": "DE L’ORDINATEUR À L’IPHONE"
        },
        "headline": {
          "en": "Type on your computer.\nSend to iPhone.",
          "zh-Hans": "在电脑上输入\n实时送到 iPhone",
          "ja": "パソコンで入力。\niPhone へすぐ送信。",
          "pt-BR": "Digite no computador.\nEnvie ao iPhone.",
          "ru": "Печатайте на ПК.\nОтправляйте на iPhone.",
          "de": "Am Computer tippen.\nAns iPhone senden.",
